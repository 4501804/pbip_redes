table '00. indicadores gerais (conteúdo)'
	lineageTag: 85e84507-7be9-4e8c-b8a4-39877c95a25e

	measure total_cliques = calculate(sum(tb_content_metrics[Clicks (total)]))
		formatString: 0
		lineageTag: 8a232eca-5bfd-43bf-8f1c-93550b59ba3e

	measure total_impressoes = calculate(sum(tb_content_metrics[Impressions (total)]))
		formatString: 0
		lineageTag: e1472325-67f7-4645-badb-55fa5be274ff

	measure total_reacoes = calculate(sum(tb_content_metrics[Reactions (total)]))
		formatString: 0
		lineageTag: 61c13750-954d-4e34-b316-c68552fcde31

	measure total_comentarios = calculate(sum(tb_content_metrics[Comments (total)]))
		formatString: 0
		lineageTag: 7e1ca214-c17d-4703-a9d7-493ae0e5aa74

	measure total_repostagens = calculate(sum(tb_content_metrics[Reposts (total)]))
		formatString: 0
