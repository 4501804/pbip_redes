	measure '(%) total_taxa_engajamento' = ([total_cliques]+[total_comentarios]+[total_repostagens]+[total_reacoes])/[total_impressoes]
		lineageTag: d1890ecd-3976-48c7-92f2-af4006354b99

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Value
		formatString: 0
