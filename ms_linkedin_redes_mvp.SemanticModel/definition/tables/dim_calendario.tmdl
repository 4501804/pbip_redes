	partition dim_calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (
				        DATE ( 2025, 1, 1 ),
				        DATE ( 2026, 12, 31 )
				    ),
				    "ano", YEAR ( [Date] ),
				    "trimestre", "t" & QUARTER ( [Date] ),
				    "mes_numero", MONTH ( [Date] ),
				    "mes", FORMAT ( [Date], "MMMM" ),
				    "ano_mes", FORMAT ( [Date], "YYYY-MM" ),
				    "dia", DAY ( [Date] ),
				    "dia_semana_numero", WEEKDAY ( [Date], 2 ),
				    "dia_semana", FORMAT ( [Date], "dddd" )
				)

	annotation PBI_Id = 560a330d4b25484facc2fc0532f2b8e5

