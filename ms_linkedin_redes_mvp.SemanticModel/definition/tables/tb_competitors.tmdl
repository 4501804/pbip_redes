	partition tb_competitors = m
		mode: import
		source =
				let
				    Fonte = SharePoint.Files(
				        "https://mackenzie365.sharepoint.com/sites/1001000598_Redes",
				        [ApiVersion = 15]
				    ),
				
				    PastaLinkedin = Table.SelectRows(
				        Fonte,
				        each Text.Contains(
				            [Folder Path],
				            "/Documentos Compartilhados/Dados/2026/Linkedin/"
				        )
				    ),
				  Navegação = PastaLinkedin{[Name = "LinkedIn Universidade Presbiteriana Mackenzie_competitor_analytics_1793150492726.xlsx", #"Folder Path" = "https://mackenzie365.sharepoint.com/sites/1001000598_Redes/Documentos Compartilhados/Dados/2026/Linkedin/"]}[Content],
				  #"Pasta de trabalho do Excel importada" = Excel.Workbook(Navegação, null, true),
				  #"Navegação 1" = #"Pasta de trabalho do Excel importada"{[Item = "COMPETITORS", Kind = "Sheet"]}[Data],
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Navegação 1", {{"Column1", type text}}),
				  #"Linhas superiores removidas" = Table.Skip(#"Tipo de coluna alterado", 1),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(#"Linhas superiores removidas", [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado 1" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"Total Followers", Int64.Type}, {"New Followers", Int64.Type}, {"Total post engagements", Int64.Type}, {"Total posts", Int64.Type}})
				in
				    #"Tipo de coluna alterado 1"

	annotation PBI_ResultType = Table

