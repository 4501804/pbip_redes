	partition tb_content_metrics = m
		mode: import
		source =
				let
				    Fonte = SharePoint.Files(
				        "https://mackenzie365.sharepoint.com/sites/1001000598_Redes",
				        [ApiVersion = 15]
				    ),
				
				    PastaLinkedin = Table.SelectRows(
				        Fonte,
				        each Text.Contains(
				            [Folder Path],
				            "/Documentos Compartilhados/Dados/2026/Linkedin/"
				        )
				    ),
				  Navegação = PastaLinkedin{[Name = "LinkedIn mackenzie1870_content_1793150457687.xlsx", #"Folder Path" = "https://mackenzie365.sharepoint.com/sites/1001000598_Redes/Documentos Compartilhados/Dados/2026/Linkedin/"]}[Content],
				  #"Pasta de trabalho do Excel importada" = Excel.Workbook(Navegação, null, true),
				  #"Navegação 1" = #"Pasta de trabalho do Excel importada"{[Item = "Metrics", Kind = "Sheet"]}[Data],
				  #"Linhas superiores removidas" = Table.Skip(#"Navegação 1", 1),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(#"Linhas superiores removidas", [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"Date", type date}, {"Impressions (organic)", Int64.Type}, {"Impressions (sponsored)", Int64.Type}, {"Impressions (total)", Int64.Type}, {"Unique impressions (organic)", Int64.Type}, {"Clicks (organic)", Int64.Type}, {"Clicks (sponsored)", Int64.Type}, {"Clicks (total)", Int64.Type}, {"Reactions (organic)", Int64.Type}, {"Reactions (sponsored)", Int64.Type}, {"Reactions (total)", Int64.Type}, {"Comments (organic)", Int64.Type}, {"Comments (sponsored)", Int64.Type}, {"Comments (total)", Int64.Type}, {"Reposts (organic)", Int64.Type}, {"Reposts (sponsored)", Int64.Type}, {"Reposts (total)", Int64.Type}, {"Engagement rate (organic)", type number}, {"Engagement rate (sponsored)", type number}, {"Engagement rate (total)", type number}})
				in
				    #"Tipo de coluna alterado"

	annotation PBI_ResultType = Table

