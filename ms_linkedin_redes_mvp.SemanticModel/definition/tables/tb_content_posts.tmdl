	partition tb_content_posts = m
		mode: import
		source =
				let
				    Fonte = SharePoint.Files(
				        "https://mackenzie365.sharepoint.com/sites/1001000598_Redes",
				        [ApiVersion = 15]
				    ),
				
				    PastaLinkedin = Table.SelectRows(
				        Fonte,
				        each Text.Contains(
				            [Folder Path],
				            "/Documentos Compartilhados/Dados/2026/Linkedin/"
				        )
				    ),
				  Navegação = PastaLinkedin{[Name = "LinkedIn mackenzie1870_content_1793150457687.xlsx", #"Folder Path" = "https://mackenzie365.sharepoint.com/sites/1001000598_Redes/Documentos Compartilhados/Dados/2026/Linkedin/"]}[Content],
				  #"Pasta de trabalho do Excel importada" = Excel.Workbook(Navegação, null, true),
				  #"Navegação 1" = #"Pasta de trabalho do Excel importada"{[Item = "All posts", Kind = "Sheet"]}[Data],
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Navegação 1", {{"Column1", type text}, {"Column2", type text}, {"Column3", type text}, {"Column4", type text}, {"Column5", type text}, {"Column6", type text}, {"Column7", type text}, {"Column8", type text}, {"Column9", type text}, {"Column20", type text}}),
				  #"Linhas superiores removidas" = Table.Skip(#"Tipo de coluna alterado", 1),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(#"Linhas superiores removidas", [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado 1" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"Impressions", Int64.Type}, {"Views", Int64.Type}, {"Created date", type date}, {"Offsite Views", Int64.Type}, {"Clicks", Int64.Type}, {"Click through rate (CTR)", type number}, {"Likes", Int64.Type}, {"Comments", Int64.Type}, {"Reposts", Int64.Type}, {"Follows", Int64.Type}, {"Engagement rate", type number}})
				in
				    #"Tipo de coluna alterado 1"

	annotation PBI_ResultType = Table

