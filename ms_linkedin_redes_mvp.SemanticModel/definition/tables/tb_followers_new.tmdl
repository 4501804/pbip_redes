	partition tb_followers_new = m
		mode: import
		source =
				let
				    Fonte = SharePoint.Files(
				        "https://mackenzie365.sharepoint.com/sites/1001000598_Redes",
				        [ApiVersion = 15]
				    ),
				
				    PastaLinkedin = Table.SelectRows(
				        Fonte,
				        each Text.Contains(
				            [Folder Path],
				            "/Documentos Compartilhados/Dados/2026/Linkedin/"
				        )
				    ),
				  Navegação = PastaLinkedin{[Name = "LinkedIn mackenzie1870_followers_1793150476997.xlsx", #"Folder Path" = "https://mackenzie365.sharepoint.com/sites/1001000598_Redes/Documentos Compartilhados/Dados/2026/Linkedin/"]}[Content],
				  #"Pasta de trabalho do Excel importada" = Excel.Workbook(Navegação, null, true),
				  #"Navegação 1" = #"Pasta de trabalho do Excel importada"{[Item = "New followers", Kind = "Sheet"]}[Data],
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(#"Navegação 1", [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"Date", type date}, {"Sponsored followers", Int64.Type}, {"Organic followers", Int64.Type}, {"Auto-invited followers", Int64.Type}, {"Total followers", Int64.Type}})
				in
				    #"Tipo de coluna alterado"

	annotation PBI_ResultType = Table

