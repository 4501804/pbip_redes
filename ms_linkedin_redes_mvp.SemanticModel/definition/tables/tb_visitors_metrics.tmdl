	partition tb_visitors_metrics = m
		mode: import
		source =
				let
				    Fonte = SharePoint.Files(
				        "https://mackenzie365.sharepoint.com/sites/1001000598_Redes",
				        [ApiVersion = 15]
				    ),
				
				    PastaLinkedin = Table.SelectRows(
				        Fonte,
				        each Text.Contains(
				            [Folder Path],
				            "/Documentos Compartilhados/Dados/2026/Linkedin/"
				        )
				    ),
				  Navegação = PastaLinkedin{[Name = "LinkedIn mackenzie1870_visitors_1793150469586.xlsx", #"Folder Path" = "https://mackenzie365.sharepoint.com/sites/1001000598_Redes/Documentos Compartilhados/Dados/2026/Linkedin/"]}[Content],
				  #"Pasta de trabalho do Excel importada" = Excel.Workbook(Navegação, null, true),
				  #"Navegação 1" = #"Pasta de trabalho do Excel importada"{[Item = "Visitor metrics", Kind = "Sheet"]}[Data],
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(#"Navegação 1", [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"Date", type date}, {"Overview page views (desktop)", Int64.Type}, {"Overview page views (mobile)", Int64.Type}, {"Overview page views (total)", Int64.Type}, {"Overview unique visitors (desktop)", Int64.Type}, {"Overview unique visitors (mobile)", Int64.Type}, {"Overview unique visitors (total)", Int64.Type}, {"Life page views (desktop)", Int64.Type}, {"Life page views (mobile)", Int64.Type}, {"Life page views (total)", Int64.Type}, {"Life unique visitors (desktop)", Int64.Type}, {"Life unique visitors (mobile)", Int64.Type}, {"Life unique visitors (total)", Int64.Type}, {"Jobs page views (desktop)", Int64.Type}, {"Jobs page views (mobile)", Int64.Type}, {"Jobs page views (total)", Int64.Type}, {"Jobs unique visitors (desktop)", Int64.Type}, {"Jobs unique visitors (mobile)", Int64.Type}, {"Jobs unique visitors (total)", Int64.Type}, {"Total page views (desktop)", Int64.Type}, {"Total page views (mobile)", Int64.Type}, {"Total page views (total)", Int64.Type}, {"Total unique visitors (desktop)", Int64.Type}, {"Total unique visitors (mobile)", Int64.Type}, {"Total unique visitors (total)", Int64.Type}})
				in
				    #"Tipo de coluna alterado"

	annotation PBI_ResultType = Table

