	measure linkedin_ranking_total_impressoes = ```
			
			RANKX(
			    ALLSELECTED(tb_content_posts[post_title_resumo]),
			    [linkedin_post_taxa_engajamento],
			    ,
			    DESC,
			    DENSE
			)
			
			```
		formatString: 0
		lineageTag: 84504e0e-c962-483c-aa85-967c3d6ce851

	measure linkedin_ranking_total_impressoes_exibicao =
			
			FORMAT([linkedin_ranking_total_impressoes], "0") & "º"
		lineageTag: e0f33426-1343-432e-be6d-302eeeccd694

	measure linkedin_metrica =
			
			SWITCH(
			    SELECTEDVALUE(dim_metrica[metrica]),
			    "Engajamento", [linkedin_post_taxa_engajamento],
			    "Reação", [linkedin_post_taxa_reacao],
			    "Amplificação", [linkedin_post_taxa_amplificacao],
			    "Conversão", [linkedin_post_taxa_conversacao],
			    "Visualização", [linkedin_post_taxa_visualizacao]
			)
		lineageTag: 24f337de-3760-4994-94ff-d7cd9766ffc9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

