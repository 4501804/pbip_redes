	measure linkedin_total_taxa_engajamento_percent = ([linkedin_total_cliques]+[linkedin_total_comentarios]+[linkedin_total_repostagens]+[linkedin_total_reacoes])/[linkedin_total_impressoes]
		lineageTag: d1890ecd-3976-48c7-92f2-af4006354b99

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure linkedin_total_reacoes = calculate(sum(tb_content_metrics[Reactions (total)]))
