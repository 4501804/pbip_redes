	measure linkedin_post_taxa_amplificacao = [linkedin_post_repostagens]/[linkedin_post_total_impressoes]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 20e28ed5-801c-411f-8723-ace7898d50b0

	measure linkedin_post_taxa_conversacao = [linkedin_post_comentarios]/[linkedin_post_total_impressoes]
