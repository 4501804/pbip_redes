	measure linkedin_post_engajamento_absoluto = [linkedin_post_cliques]+[linkedin_post_curtidas]+[linkedin_post_comentarios]+[linkedin_post_repostagens]+[linkedin_post_seguidores_gerados]
		formatString: 0
		lineageTag: 7db3799d-2d5f-4b74-949c-4a9c16773ba6

