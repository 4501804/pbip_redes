		lineageTag: 1b522d19-c762-4acd-bbad-40ecbb63e5fe

	measure linkedin_post_taxa_engajamento = ([linkedin_post_cliques]+[linkedin_post_comentarios]+[linkedin_post_repostagens])/[linkedin_post_total_impressoes]
		formatString: 0%;-0%;0%
		lineageTag: c04449c6-069a-4ce4-9110-a0b97177f198

	measure linkedin_post_taxa_reacao = [linkedin_post_curtidas]/[linkedin_post_total_impressoes]
