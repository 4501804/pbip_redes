	partition tb_instagram_posts = m
		mode: import
		source =
				let
				    Fonte = SharePoint.Files(
				        "https://mackenzie365.sharepoint.com/sites/1001000598_Redes",
				        [ApiVersion = 15]
				    ),
				
				    PastaInstagram = Table.SelectRows(
				        Fonte,
				        each Text.Contains(
				            [Folder Path],
				            "/Documentos Compartilhados/Dados/2026/Instagram/"
				        )
				    ),
				
				    OrdenadoPorData = Table.Sort(
				        PastaInstagram,
				        {{"Date modified", Order.Descending}}
				    ),
				
				    ArquivoMaisRecente = Table.FirstN(
				        OrdenadoPorData,
				        1
				    ),
				  Navegação = ArquivoMaisRecente{[Name = "Jan-01-2026_Nov-12-2026_1421407346646773.csv", #"Folder Path" = "https://mackenzie365.sharepoint.com/sites/1001000598_Redes/Documentos Compartilhados/Dados/2026/Instagram/"]}[Content],
				  #"CSV Importado" = Csv.Document(Navegação, [Delimiter = ",", Columns = 18, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(#"CSV Importado", [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"Identificação do post", Int64.Type}, {"Identificação da conta", Int64.Type}, {"Nome de usuário da conta", type text}, {"Nome da conta", type text}, {"Descrição", type text}, {"Duração (s)", Int64.Type}, {"Horário de publicação", type datetime}, {"Link permanente", type text}, {"Tipo de post", type text}, {"Comentário de dados", type text}, {"Data", type text}, {"Visualizações", Int64.Type}, {"Alcance", Int64.Type}, {"Curtidas", Int64.Type}, {"Compartilhamentos", Int64.Type}, {"Seguimentos", Int64.Type}, {"Comentários", Int64.Type}, {"Salvamentos", Int64.Type}}, "pt-BR"),
				  #"Colunas removidas" = Table.RemoveColumns(#"Tipo de coluna alterado", {"Data", "Comentário de dados"})
				
				in
				    #"Colunas removidas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

